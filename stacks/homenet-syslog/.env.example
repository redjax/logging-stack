# Container images
LOKI_IMAGE=grafana/loki:latest
ALLOY_IMAGE=grafana/alloy:latest
GRAFANA_IMAGE=grafana/grafana:latest
PROMETHEUS_IMAGE=prom/prometheus:latest

## Default: 1.0
LOKI_CPUS=
## Default: 384M
LOKI_MEM_LIMIT=

## Default: 0.5
ALLOY_CPUS=
## Default: 128M
ALLOY_MEM_LIMIT=

## Default: 1.0
GRAFANA_CPUS=
## Default: 256M
GRAFANA_MEM_LIMIT=

## Default: 0.5
PROMETHEUS_CPUS=
## Default: 256M
PROMETHEUS_MEM_LIMIT=

# Host ports; published on 127.0.0.1
LOKI_HTTP_PORT=3100
ALLOY_HTTP_PORT=12345
LOKI_MAX_QUERY_SERIES=10000

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HTTP_PORT=3000

# Identifies this collector
ALLOY_NODE_NAME=rpi-syslog
# File written by host rsyslog
MODEM_LOG_PATH=/var/log/modem

## Default: 127.0.0.1
PROMETHEUS_BIND_ADDRESS=
## Default: 9090
PROMETHEUS_HTTP_PORT=
## Default: 15d
PROMETHEUS_RETENTION_TIME=
## Default: 2GB
PROMETHEUS_RETENTION_SIZE=
## Default: ./config/prometheus/prometheus.yml
PROMETHEUS_CONFIG_FILE=
## Default: (named volume) prometheus_data
PROMETHEUS_DATA_DIR=

## Default: latest
NODE_EXPORTER_IMAGE=
## Default: 0.25
NODE_EXPORTER_CPUS=
## Default: 64M
NODE_EXPORTER_MEM_LIMIT=
## Default: 127.0.0.1

