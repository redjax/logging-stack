## Default: Etc/UTC
TZ=

## Default: grafana/loki:latest
LOKI_IMAGE=
## Default: prom/prometheus:latest
PROMETHEUS_IMAGE=
## Default: grafana/grafana:latest
GRAFANA_IMAGE=
## Default: latest
NAUTICAL_IMAGE=

## Default: 1.0
LOKI_CPUS=
## Default: 512M
LOKI_MEM_LIMIT=
## Default: 0.0.0.0
LOKI_BIND_ADDRESS=
## Default: 3100
LOKI_HTTP_PORT=
## Default: ./config/loki/loki.yml
LOKI_CONFIG_FILE=
## Default: loki_data
LOKI_DATA_DIR=

## Default: 0.5
PROMETHEUS_CPUS=
## Default: 384M
PROMETHEUS_MEM_LIMIT=
## Default: 30d
PROMETHEUS_RETENTION_TIME=
## Default: 5GB
PROMETHEUS_RETENTION_SIZE=
## Default: 0.0.0.0
PROMETHEUS_BIND_ADDRESS=
## Default: 9090
PROMETHEUS_HTTP_PORT=
## Default: ./config/prometheus/prometheus.yml
PROMETHEUS_CONFIG_FILE=
## Default: prometheus_data
PROMETHEUS_DATA_DIR=
## Default: ./config/prometheus/targets
PROMETHEUS_TARGETS_DIR=

## Default: 1.0
GRAFANA_CPUS=
## Default: 384M
GRAFANA_MEM_LIMIT=
## Default: admin
GRAFANA_ADMIN_USER=
## Default: Set GRAFANA_ADMIN_PASSWORD
GRAFANA_ADMIN_PASSWORD=
## Default: 0.0.0.0
GRAFANA_BIND_ADDRESS=
## Default: 3000
GRAFANA_HTTP_PORT=
## Default: grafana_data
GRAFANA_DATA_DIR=
## Default: ./config/grafana/provisioning
GRAFANA_PROVISIONING_DIR=

## Default: 0 4 * * *
NAUTICAL_CRON_SCHEDULE=
## Default: (named volume) nautical_data
NAUTICAL_DATA_DIR=
## Default: (none/empty)
#  Host path must exist before running container.
NAUTICAL_BACKUP_DIR=
